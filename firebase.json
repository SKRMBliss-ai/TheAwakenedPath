{
  "firestore": {
    "database": "(default)",
    "location": "us-central1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/simplypiano{,/**}",
        "destination": "https://simplypiano.web.app",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
          },
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.razorpay.com https://apis.google.com https://accounts.google.com https://www.googletagmanager.com https://*.clarity.ms https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.google.com https://*.gstatic.com https://*.firebaseio.com wss://*.firebaseio.com https://*.cloudfunctions.net https://*.razorpay.com https://*.clarity.ms https://*.google-analytics.com https://ipapi.co https://cloudflare-dns.com; frame-src 'self' https://*.razorpay.com https://www.youtube.com https://youtube.com https://*.firebaseapp.com https://accounts.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|mp3|wav|woff2|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/witness",
        "function": {
          "functionId": "witnessPresence",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/grounding",
        "function": {
          "functionId": "getGrounding",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/voice",
        "function": {
          "functionId": "textToSpeech",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/daily-meditation",
        "function": {
          "functionId": "getDailyMeditation",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/emotion",
        "function": {
          "functionId": "analyzeEmotion",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/razorpay-order",
        "function": {
          "functionId": "createRazorpayOrder",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/razorpay-verify",
        "function": {
          "functionId": "verifyRazorpayPayment",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/razorpay-webhook",
        "function": {
          "functionId": "razorpayWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/unsubscribe",
        "function": {
          "functionId": "unsubscribe",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/razorpay-subscription",
        "function": {
          "functionId": "createRazorpaySubscription",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/razorpay-subscription-verify",
        "function": {
          "functionId": "verifyRazorpaySubscription",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/jitsi-token",
        "function": {
          "functionId": "getJitsiToken",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/latest-videos",
        "function": {
          "functionId": "getLatestVideos",
          "region": "us-central1"
        }
      },
      {
        "source": "**/!(*.*)",
        "destination": "/index.html"
      }
    ]
  }
}