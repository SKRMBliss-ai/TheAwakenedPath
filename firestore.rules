rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // SECURITY: require email_verified=true — Firebase Auth lets anyone sign up
      // with email/password using ANY email address; only verified emails should
      // be trusted. Without this, an attacker could register as an admin email
      // (unverified) and gain full admin access.
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'shrutikhungar@gmail.com' ||
          request.auth.token.email == 'simkatyal1@gmail.com' ||
          request.auth.token.email == 'smriti.duggal@gmail.com' ||
          request.auth.token.email == 'rashmi.purbey@gmail.com' ||
          request.auth.token.email == 'skrmblissai@gmail.com'
        );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Paid-entitlement fields on a user doc. These are set ONLY by the payment
    // Cloud Functions (Admin SDK, which bypasses these rules). A client must
    // never be able to grant itself access by writing them directly — otherwise
    // anyone could unlock every paid course/premium for free from devtools.
    function entitlementsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['purchasedCourses', 'ownedTracks', 'subscriptionStatus', 'subscriptionId', 'membershipUntil']);
    }

    // On create, entitlement fields may only be seeded to their empty defaults
    // (the app writes purchasedCourses: [], subscriptionStatus: 'INACTIVE'), so a
    // user can't self-provision by pre-filling them on the very first write.
    // membershipUntil (pay-what-you-want membership expiry) must be absent
    // entirely — there's no legitimate "empty" value for a timestamp field.
    function entitlementsSeedSafe() {
      let d = request.resource.data;
      return (!('purchasedCourses' in d) || d.purchasedCourses.size() == 0)
        && (!('ownedTracks' in d) || d.ownedTracks.size() == 0)
        && (!('subscriptionStatus' in d) || d.subscriptionStatus == 'INACTIVE')
        && (!('subscriptionId' in d))
        && (!('membershipUntil' in d));
    }

    // The user doc itself — entitlement fields are guarded here.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && entitlementsSeedSafe());
      allow update: if isAdmin() || (isOwner(userId) && entitlementsUnchanged());
      allow delete: if isAdmin();
    }

    // Subcollections (courseProgress, courseMeta, …) — owner has full access; no
    // entitlements live here. This is a SIBLING match, scoped to paths at least
    // one collection + doc deep, so it can NOT match the user doc above (whose
    // permissive write would otherwise override the entitlement guard).
    match /users/{userId}/{coll}/{doc=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /activity_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    match /error_logs/{errId} {
      // Any signed-in (incl. anonymous) client can report a crash, but only with
      // the expected shape and bounded sizes so it can't be used to spam Firestore.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['message','stack','feature','kind','url','userAgent','uid','email','timestamp'])
        && request.resource.data.message is string
        && request.resource.data.message.size() < 2000
        && request.resource.data.stack.size() < 5000;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /email_blasts/{blastId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /email_opens/{openId} {
      // The tracking pixel is fired anonymously by email clients, so we can't gate
      // creation behind auth — but we DO restrict shape to prevent garbage spam:
      //  - exactly the expected fields
      //  - reasonable size limits
      //  - no other writes (only create) and no read except admin
      allow create: if request.resource.data.keys().hasOnly(['blastId', 'userEmail', 'timestamp'])
        && request.resource.data.blastId is string
        && request.resource.data.blastId.size() < 200
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() < 200;
      allow read: if isAdmin();
    }
    
    match /email_clicks/{id} {
      allow read: if isAdmin();
    }
    
    match /email_unsubscribes/{id} {
      allow read: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    match /lead_scans/{scanId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /waitlist/{entryId} {
      // Anonymous email captures from marketing landing pages (/aboutmindgym,
      // /feelingsandemotioncourse). Strict shape validation prevents abuse and
      // unbounded writes. Must match the exact fields the app actually sends —
      // 'mailingList' and 'type' were added to app code but never allow-listed
      // here, which silently broke every waitlist signup (permission-denied).
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'userAgent', 'createdAt', 'mailingList', 'type'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.source is string
        && request.resource.data.source.size() < 60;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── DAILY MEDITATION ROOM ─────────────────────────────────────────────────

    match /meditation_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;

      match /participants/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && (request.auth.uid == uid || isAdmin());
      }

      match /signals/{sigId} {
        allow read: if request.auth != null
          && (resource.data.to == request.auth.uid
            || resource.data.from == request.auth.uid);
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid;
        allow update: if request.auth != null
          && resource.data.to == request.auth.uid;
      }

      match /chat/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text.size() <= 100;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /meditation_attendance/{id} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /meditation_journals/{id} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /meditation_streaks/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    // ── COMMUNITY PRESENCE ────────────────────────────────────────────────────
    // "Who is here right now", readable by every signed-in member so the member
    // directory can render. This is a SEPARATE collection from /users on
    // purpose: /users is owner-read only because it holds emails and paid
    // entitlements, and none of that may leak into a list everyone can read.
    //
    // Writes are restricted to the member's own doc AND to the display-only
    // field set below, so nobody can smuggle an email (or any other field) into
    // a world-readable document, or write a presence entry as someone else.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'displayName', 'avatarUrl', 'area', 'lastSeen'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60;
      allow delete: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }

    // ── SHARED PRACTICE · insights & questions ────────────────────────────────
    // The community feed. EVERYTHING in this collection is public to signed-in
    // members by design — an entry only reaches here when the member chose to
    // share it.
    //
    // Entries marked "Private to me" are never written here at all; they go to
    // users/{uid}/practiceEntries, which the owner-only subcollection rule
    // above already protects. Privacy is enforced by WHERE the document lives,
    // not by a field the client filters on — a boolean filtered in the client
    // would leave private text readable to anyone who queried this collection
    // directly, and members will reasonably trust that toggle.
    //
    // A member may only create entries under their own uid, and may only edit
    // or delete their own.
    match /practice_entries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.shared == true
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.kind in ['insight', 'question'];
      allow update, delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ── PRACTICE OF THE WEEK ──────────────────────────────────────────────────
    // The permanent practice library. Readable by every member; a practice is
    // never deleted — it resurfaces in a later week instead of being replaced,
    // so `delete` is refused for everyone but an admin, and even then it should
    // be a last resort: removing one rewrites the history of every week that
    // used it.
    match /practice_library/{practiceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (request.auth != null && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    // One assignment document per week number, SHARED by everyone — this is
    // what puts the whole community on the same practice in the same week.
    // Any member may create a missing week (the choice is deterministic, so
    // whoever gets there first computes the same answer everyone else would),
    // but only an admin may change one that already exists: a member changing
    // last week's assignment would rewrite history for the entire community.
    match /practice_assignments/{weekNumber} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.practiceId is string;
      allow update, delete: if isAdmin();
    }
  }
}