rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // SECURITY: require email_verified=true — Firebase Auth lets anyone sign up
      // with email/password using ANY email address; only verified emails should
      // be trusted. Without this, an attacker could register as an admin email
      // (unverified) and gain full admin access.
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'shrutikhungar@gmail.com' ||
          request.auth.token.email == 'simkatyal1@gmail.com' ||
          request.auth.token.email == 'smriti.duggal@gmail.com' ||
          request.auth.token.email == 'rashmi.purbey@gmail.com' ||
          request.auth.token.email == 'skrmblissai@gmail.com'
        );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Paid-entitlement fields on a user doc. These are set ONLY by the payment
    // Cloud Functions (Admin SDK, which bypasses these rules). A client must
    // never be able to grant itself access by writing them directly — otherwise
    // anyone could unlock every paid course/premium for free from devtools.
    function entitlementsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['purchasedCourses', 'ownedTracks', 'subscriptionStatus', 'subscriptionId', 'membershipUntil']);
    }

    // On create, entitlement fields may only be seeded to their empty defaults
    // (the app writes purchasedCourses: [], subscriptionStatus: 'INACTIVE'), so a
    // user can't self-provision by pre-filling them on the very first write.
    // membershipUntil (pay-what-you-want membership expiry) must be absent
    // entirely — there's no legitimate "empty" value for a timestamp field.
    function entitlementsSeedSafe() {
      let d = request.resource.data;
      return (!('purchasedCourses' in d) || d.purchasedCourses.size() == 0)
        && (!('ownedTracks' in d) || d.ownedTracks.size() == 0)
        && (!('subscriptionStatus' in d) || d.subscriptionStatus == 'INACTIVE')
        && (!('subscriptionId' in d))
        && (!('membershipUntil' in d));
    }

    // The user doc itself — entitlement fields are guarded here.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && entitlementsSeedSafe());
      allow update: if isAdmin() || (isOwner(userId) && entitlementsUnchanged());
      allow delete: if isAdmin();
    }

    // Subcollections (courseProgress, courseMeta, …) — owner has full access; no
    // entitlements live here. This is a SIBLING match, scoped to paths at least
    // one collection + doc deep, so it can NOT match the user doc above (whose
    // permissive write would otherwise override the entitlement guard).
    match /users/{userId}/{coll}/{doc=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /activity_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    match /error_logs/{errId} {
      // Any signed-in (incl. anonymous) client can report a crash, but only with
      // the expected shape and bounded sizes so it can't be used to spam Firestore.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['message','stack','feature','kind','url','userAgent','uid','email','timestamp'])
        && request.resource.data.message is string
        && request.resource.data.message.size() < 2000
        && request.resource.data.stack.size() < 5000;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /email_blasts/{blastId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /email_opens/{openId} {
      // The tracking pixel is fired anonymously by email clients, so we can't gate
      // creation behind auth — but we DO restrict shape to prevent garbage spam:
      //  - exactly the expected fields
      //  - reasonable size limits
      //  - no other writes (only create) and no read except admin
      allow create: if request.resource.data.keys().hasOnly(['blastId', 'userEmail', 'timestamp'])
        && request.resource.data.blastId is string
        && request.resource.data.blastId.size() < 200
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() < 200;
      allow read: if isAdmin();
    }
    
    match /email_clicks/{id} {
      allow read: if isAdmin();
    }
    
    match /email_unsubscribes/{id} {
      allow read: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    match /lead_scans/{scanId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /waitlist/{entryId} {
      // Anonymous email captures from marketing landing pages (/aboutmindgym,
      // /feelingsandemotioncourse). Strict shape validation prevents abuse and
      // unbounded writes. Must match the exact fields the app actually sends —
      // 'mailingList' and 'type' were added to app code but never allow-listed
      // here, which silently broke every waitlist signup (permission-denied).
      allow create: if request.resource.data.keys().hasOnly(['email', 'source', 'userAgent', 'createdAt', 'mailingList', 'type'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.source is string
        && request.resource.data.source.size() < 60;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── DAILY MEDITATION ROOM ─────────────────────────────────────────────────

    match /meditation_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;

      match /participants/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && (request.auth.uid == uid || isAdmin());
      }

      match /signals/{sigId} {
        allow read: if request.auth != null
          && (resource.data.to == request.auth.uid
            || resource.data.from == request.auth.uid);
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid;
        allow update: if request.auth != null
          && resource.data.to == request.auth.uid;
      }

      match /chat/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text.size() <= 100;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /meditation_attendance/{id} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /meditation_journals/{id} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /meditation_streaks/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
    }
  }
}